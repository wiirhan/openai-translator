{
    "compilerOptions": {
        "strict": true,
        "lib": ["DOM", "DOM.Iterable", "es2015"],
        "allowJs": false,
        "useDefineForClassFields": true,
        "module": "ESNext",
        "target": "es2017",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "rootDir": ".",
        "outDir": "dist/js",
        "moduleResolution": "node",
        "noEmit": true,
        "noEmitOnError": true,
        "jsx": "react-jsx",
        "typeRoots": ["node_modules/@types/", "node_modules"],
        "resolveJsonModule": true,
        "types": ["vite-plugin-svgr/client", "vite/client"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/common", "src/tauri", "src/index.d.ts", "src-tauri", "vite.config.ts", "vite.config.tauri.ts", ".eslintrc.js"],
    "exclude": ["src/browser-extension", "src-safari", "e2e", "src/common/background", "src/common/polyfills/electron.ts", "src/common/polyfills/userscript.ts", "playwright.config.ts", "vite.config.chromium.ts", "vite.config.firefox.ts", "vite.config.userscript.ts"]
}
